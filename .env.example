# ─── Required: Database ──────────────────────────────────────────────────────
# Get a free Postgres URL from https://neon.tech (connect → connection string)
# Format: postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── Required: GitHub ────────────────────────────────────────────────────────
# Fine-grained token: Settings → Developer settings → Fine-grained tokens
# Permissions needed: Contents (read+write), Pull requests (read+write), Workflows (read)
GITHUB_TOKEN=ghp_...
GITHUB_REPO=thirdeye2112/engineering-agent

# ─── Required: AI provider (pick one) ───────────────────────────────────────
# Anthropic — https://console.anthropic.com/keys
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# Google — https://aistudio.google.com/app/apikey
# GOOGLE_API_KEY=...

# ─── Replit only (injected automatically, do not set manually) ───────────────
# AI_INTEGRATIONS_ANTHROPIC_API_KEY — set by Replit AI integration
# AI_INTEGRATIONS_ANTHROPIC_BASE_URL — set by Replit AI integration
