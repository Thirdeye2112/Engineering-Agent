{
  "name": "consensus-ai",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "pnpm --filter api-server dev",
    "web:dev": "pnpm --filter @consensus/web dev",
    "build": "pnpm -r build",
    "db:push": "pnpm --filter @consensus/db db:push",
    "db:generate": "pnpm --filter @consensus/db db:generate",
    "pilot": "pnpm --filter @consensus/pilot pilot",
    "pilot:auto": "pnpm --filter @consensus/pilot pilot:auto",
    "suite": "pnpm --filter @consensus/pilot suite",
    "suite:auto": "pnpm --filter @consensus/pilot suite:auto",
    "sync-outcomes": "pnpm --filter @consensus/pilot sync-outcomes"
  },
  "engines": { "node": ">=20" },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
